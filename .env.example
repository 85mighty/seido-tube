# ---- 대본/기사 생성 ----
ANTHROPIC_API_KEY=            # 비우면 VPS의 `claude -p` CLI 로 폴백 (Claude Code 구독 사용)
CLAUDE_MODEL=claude-sonnet-5-5
CHARS_PER_MIN=290             # 벤치마크 자동자막 실측(롤링 중복 제거 후). benchmark_sync 가 자동 갱신
MINUTES=15                    # 벤치마크 중앙값 21분(2026년은 25분). 1차는 15분, 안정되면 20분+

# ---- 캐릭터/일러스트 ----
IMAGE_PROVIDER=none           # openai | fal | none
OPENAI_API_KEY=
FAL_KEY=

# ---- 음성 ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- YouTube / Telegram ----
YOUTUBE_API_KEY=              # Data API v3 키: 벤치마크 메타데이터(업로드일·좋아요) 수집용, 봇 차단 무관
# config/client_secret.json 필요 (README 참조)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 블로그 ----
SEIDO_WP_URL=https://seido-note.com
SEIDO_WP_USER=
SEIDO_WP_APP_PASS=
HATENA_ID=
HATENA_BLOG=seido-note.hatenablog.com
HATENA_API_KEY=
